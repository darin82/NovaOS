[Plymouth Theme]
Name=NovaOS
Description=NovaOS boot and shutdown animation
ModuleName=two-step

[two-step]
Font=Noto Sans 12
TitleFont=Noto Sans 22
ImageDir=/usr/share/plymouth/themes/novaos
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.38
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.38
HorizontalAlignment=.5
VerticalAlignment=.60
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.88
Transition=none
TransitionDuration=0
BackgroundStartColor=0x08080c
BackgroundEndColor=0x12121a
ProgressBarBackgroundColor=0x383044
ProgressBarForegroundColor=0x8b5cf6
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false
