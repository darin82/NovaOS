#!/bin/sh
set -eu
export LC_ALL=C

report=/usr/lib/novaos/reports
install -d -m 0755 "$report"
{
    printf 'package\tversion\tsource\tsection\tinstalled_kib\n'
    dpkg-query -W -f='${db:Status-Status}\t${binary:Package}\t${Version}\t${source:Package}\t${Section}\t${Installed-Size}\n' \
        | awk -F '\t' '$1 == "installed" {sub(/^[^\t]*\t/, ""); print}'
} > "$report/installed-packages.tsv"

# Preserve Debian's per-package notices, including paths shared by symlink.
printf 'package\tnotice_path\n' > "$report/license-notice-index.tsv"
printf '%s\n' usr/share/common-licenses > "$report/license-paths.tmp"
awk -F '\t' 'NR>1 {sub(/:.*/, "", $1); print $1}' "$report/installed-packages.tsv" | sort -u |
while IFS= read -r package; do
    path="usr/share/doc/$package/copyright"
    if [ -f "/$path" ]; then
        printf '%s\n' "$path" >> "$report/license-paths.tmp"
        printf '%s\t%s\n' "$package" "$path"
    else
        printf '%s\t%s\n' "$package" 'not present in image'
    fi
done >> "$report/license-notice-index.tsv"
tar --dereference -C / --files-from="$report/license-paths.tmp" \
    -czf "$report/package-license-notices.tar.gz"
rm "$report/license-paths.tmp"

{
    printf 'scope\tunit\tstate\tcommand_or_target\n'
    for scope in system user; do
        options=
        if [ "$scope" = user ]; then
            options=--global
        fi
        systemctl $options --root=/ list-unit-files --no-pager --no-legend > "$report/units.tmp"
        awk -v scope="$scope" 'NF >= 2 {printf "%s\t%s\t%s\t\n", scope, $1, $2}' "$report/units.tmp"
    done
    rm "$report/units.tmp"

    # Static dependencies installed as wants/requires can start units without enablement.
    for scope in system user; do
        for directory in /etc/systemd/"$scope" /usr/lib/systemd/"$scope"; do
            [ -d "$directory" ] || continue
            for link in "$directory"/*.wants/* "$directory"/*.requires/*; do
                [ -L "$link" ] || continue
                name=${link##*/}
                state=wanted
                if [ "$(readlink "/etc/systemd/$scope/$name" 2>/dev/null || true)" = /dev/null ]; then
                    state=masked
                fi
                printf '%s\t%s\t%s\t%s\n' "$scope" "$name" "$state" "${link%/*}"
            done
        done
    done

    for entry in /etc/xdg/autostart/*.desktop /usr/share/autostart/*.desktop; do
        [ -f "$entry" ] || continue
        state=xdg-autostart
        if grep -Eiq '^Hidden=true[[:space:]]*$' "$entry"; then
            state=hidden
        fi
        command=$(sed -n 's/^Exec=//p' "$entry" | head -n 1 | tr '\t' ' ')
        printf 'desktop\t%s\t%s\t%s\n' "${entry##*/}" "$state" "$command"
    done
} > "$report/background-services.tsv"
