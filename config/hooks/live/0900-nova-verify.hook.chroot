#!/bin/sh
set -eu

test -r /usr/share/wayland-sessions/plasma.desktop
test -x /usr/bin/startplasma-wayland
test -x /usr/lib/live/config/0086-nova-sddm
test -r /usr/share/color-schemes/NovaMidnight.colors
test -r /usr/share/wallpapers/NovaOS/contents/images/1920x1080.svg
test -r /usr/share/desktop-base/nova-logo.svg
test -r /usr/lib/x86_64-linux-gnu/qt6/plugins/kf6/kio/kio_filenamesearch.so

for executable in flatpak nmcli wpctl kdialog Xorg plasma-apply-colorscheme \
    kreadconfig6 kwriteconfig6 qdbus6 nova-appearance nova-update nova-gaming apt-get apt-cache qml6 powerprofilesctl \
    nova-music nova-store mpv ffprobe ffmpeg nova-install nova-recovery nova-welcome \
    nova-update-notify nova-benchmark calamares grub-install update-grub efibootmgr; do
    command -v "$executable" >/dev/null
done
test -x /usr/lib/systemd/system-generators/zram-generator
test -r /usr/lib/mpv-mpris/mpris.so
# Retain upstream desktop IDs, MIME types and actions, including native shortcuts.
install -d -m 0755 /usr/local/share/applications
while IFS='|' read -r entry name icon executable visibility; do
    case "$entry" in ''|'#'*) continue ;; esac
    command -v "$executable" >/dev/null
    managed=0
    monitor=0
    case "$executable" in firefox-esr|dolphin|konsole) managed=1 ;; esac
    case "$executable" in plasma-systemmonitor) monitor=1 ;; esac
    override="/usr/local/share/applications/$entry"
    awk -v name="$name" -v icon="$icon" -v visibility="$visibility" -v managed="$managed" -v monitor="$monitor" \
        -f /usr/lib/novaos/brand-launchers.awk "/usr/share/applications/$entry" > "$override"
    grep -Fxq "Name=$name" "$override"
    grep -q '^Exec=' "$override"
done < /usr/lib/novaos/launchers.tsv
test -r /usr/share/applications/org.novaos.Update.desktop

# Enable network management and make the display manager the boot target.
systemctl enable NetworkManager.service sddm.service
# The vendor D-Bus service can still start this unit when requested by clients.
systemctl disable power-profiles-daemon.service
# SMART reads are explicitly invoked by Recovery. No startup drive patrol.
systemctl disable smartmontools.service
systemctl --global enable nova-update-notify.timer
test -r /etc/calamares/settings.conf
test -r /usr/lib/calamares/modules/nova-install/main.py
test -r /usr/share/calamares/helpers/calamares-bootloader-config
# Preserve native password and fallback handling for encrypted boots.
for asset in /usr/share/plymouth/themes/spinner/*.png; do
    [ -f "$asset" ] || continue
    [ "${asset##*/}" != watermark.png ] || continue
    install -m0644 "$asset" /usr/share/plymouth/themes/novaos/
done
plymouth-set-default-theme novaos
test -r /usr/share/sddm/themes/novaos/Main.qml
test -x /usr/lib/novaos/ai/nova-ai
test -x /usr/lib/novaos/nova-music.py
test -x /usr/lib/novaos/nova-welcome-action.py
systemctl set-default graphical.target

# Keep the base-files copy at /usr/lib/os-release for upstream maintenance.
if [ -L /etc/os-release ]; then
    rm /etc/os-release
fi
install -m 0644 /usr/lib/novaos/os-release /etc/os-release
grep -q 'trixie-security' /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null || {
    echo 'Debian security repository missing from chroot APT configuration' >&2
    exit 1
}
