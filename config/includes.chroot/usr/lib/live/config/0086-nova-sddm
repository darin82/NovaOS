#!/bin/sh
set -eu

. /usr/lib/live/config.sh

case "${LIVE_CONFIG_NOAUTOLOGIN:-}:${LIVE_CONFIG_NOX11AUTOLOGIN:-}" in
    true:*|*:true) exit 0 ;;
esac

for parameter in ${LIVE_CONFIG_CMDLINE}; do
    case "$parameter" in
        live-config.noautologin|noautologin|live-config.nox11autologin|nox11autologin)
            exit 0 ;;
        live-config.username=*|username=*)
            LIVE_USERNAME=${parameter#*=} ;;
    esac
done

if component_was_executed nova-sddm; then
    exit 0
fi

getent passwd "$LIVE_USERNAME" >/dev/null
test -r /usr/share/wayland-sessions/plasma.desktop
install -d -m 0755 /etc/sddm.conf.d

cat > /etc/sddm.conf.d/90-nova-live.conf <<EOF
[Autologin]
User=$LIVE_USERNAME
Session=plasma.desktop
Relogin=false
EOF

touch /var/lib/live/config/xinit /var/lib/live/config/nova-sddm
